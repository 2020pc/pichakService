<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                            http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="systemPropertiesModeName" value="SYSTEM_PROPERTIES_MODE_OVERRIDE"/>
        <property name="locations">
            <list>
                <value>classpath:gateway-jms.properties</value>
            </list>
        </property>
    </bean>

    <import resource="applicationContext-gateway-spi-${gateway.spi.profile:SOCKET}.xml"/>

    <bean id="channelManager"
          class="com.caspian.moderngateway.spi.service.DefaultChannelManagerProvider"/>
</beans>
